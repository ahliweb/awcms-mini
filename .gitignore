# Dependencies
node_modules/

# Environment (never commit secrets)
.env
.env.*
!.env.example

# Local dev-only Docker Compose overrides (Issue #682) — auto-loaded by
# `docker compose`, never committed (each operator's own local port/volume
# preferences, not shared config). See docker-compose.override.yml.example.
docker-compose.override.yml

# PgBouncer SCRAM verifier file (Issue #682) — contains SCRAM-SHA-256
# verifiers (equivalent to password hashes; usable for offline dictionary
# attacks against DB roles), never committed. See
# deploy/pgbouncer/pgbouncer.ini.example's header for how to generate it.
userlist.txt

# Build output
dist/
.astro/
build/

# Local storage & backups
storage/
*.dump
*.sql.gz

# Local runtime artifacts (e.g. REPORTING_EXPORT_ROOT_PATH default output)
/var/

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Playwright E2E artifacts
playwright-report/
test-results/
blob-report/

# Claude Code user-local settings (jangan commit)
.claude/settings.local.json

# Worktree agent Claude Code (isolation: "worktree") — dibuat DI DALAM repo,
# jadi tanpa aturan ini `git add -A` bisa meng-commit seluruh checkout agent.
# Terungkap saat epic #818 gelombang 1 menjalankan 6 agent paralel.
.claude/worktrees/

# Cache inkremental graphify (AST + embedding semantic per file, ratusan file
# kecil yang di-regenerate otomatis saat sumbernya berubah). Hasil akhir graph
# (graph.json/GRAPH_REPORT.md/manifest.json) TETAP di-commit.
graphify-out/cache/
# Penanda lokal per-mesin (absolute path checkout + interpreter uv), bukan hasil.
graphify-out/.graphify_root
graphify-out/.graphify_python
# Backup bertanggal yang ditulis graphify tiap kali graph di-recluster — masing-masing
# berisi SALINAN PENUH graph.json (~21 MB). Berguna lokal sebagai undo, tapi
# meng-commit-nya menggandakan blob terbesar repo tiap regenerate.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# Turunan run terakhir (analisis + signature label), di-regenerate bersama graph.
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json.sig
# graph.html TIDAK lagi di-commit. Graph sudah melewati batas viz default
# (11.130 node > 5.000), sehingga graphify melewatinya kecuali
# GRAPHIFY_VIZ_NODE_LIMIT dinaikkan — dan pada ukuran ini bundel HTML-nya ~16 MB
# dan praktis tak bisa dibuka. Membiarkan berkas lama ter-commit berarti
# menyimpan visualisasi yang TIDAK cocok dengan graph.json di sebelahnya, dan itu
# lebih buruk daripada tidak ada. Regenerate lokal bila perlu:
#   GRAPHIFY_VIZ_NODE_LIMIT=15000 graphify cluster-only .
graphify-out/graph.html
